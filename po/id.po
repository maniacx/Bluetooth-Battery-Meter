msgid "Enable BudsLink integration"
msgstr "Aktifkan integrasi BudsLink"

#: ui/budslinkCompanion.ui:17
msgid ""
"Acts as a Companion with the BudsLink app, which runs in the background to "
"provide additional features for supported headphones and earbuds"
msgstr ""
"Berfungsi sebagai pendamping aplikasi BudsLink, yang berjalan di latar "
"belakang untuk menyediakan fitur tambahan bagi headphone dan earbud yang "
"didukung"

#: ui/budslinkCompanion.ui:22
msgid "Hide from Background Apps"
msgstr "Sembunyikan dari Aplikasi Latar Belakang"

#: ui/budslinkCompanion.ui:23
msgid "Hide BudsLink from the GNOME Background Apps list"
msgstr "Sembunyikan BudsLink dari daftar Aplikasi Latar Belakang GNOME"

#: ui/budslinkCompanion.ui:31
msgid "Installation Status"
msgstr "Status Instalasi"

#: ui/budslinkCompanion.ui:40
msgid "BudsLink Installation Status"
msgstr "Status Instalasi BudsLink"

#: ui/budslinkCompanion.ui:49
msgid "BudsLink on Flathub"
