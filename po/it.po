msgid "Default Behaviour"
msgstr "Compotamento predefinito"

#: ui/indicator.ui:108
msgid "Hide Always"
msgstr "Nascondi sempre"

#: ui/indicator.ui:109
msgid "Hide Conditionally"
msgstr "Nascondi condizionalmente"

