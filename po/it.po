msgstr "Visualizza la percentuale del livello della batteria in cifre"

#: ui/quickSettings.ui:38
msgid "Display battery level icon before text"
msgstr "Visualizza l'icona del livello della batteria prima delle cifre"

#: ui/quickSettings.ui:39
msgid "Swaps position of battery level icon and percentage text"
msgstr "Scambia la posizione dell'icona del livello e delle cifre percentuali"

#: ui/quickSettings.ui:46
msgid "Sort By History"
msgstr "Ordina per cronologia"

#: ui/quickSettings.ui:49
