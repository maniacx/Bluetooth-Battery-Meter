msgstr "Paramètres de l'indicateur"

#: ui/batteryWidgetSettings.ui:12
msgid "Indicator Battery Widget Settings available only for System Tray mode or Panel Button mode with multiple indicators"
msgstr "Les paramètres du widget de batterie de l’indicateur ne sont disponibles que pour le mode barre d’état système ou le mode bouton du panneau avec plusieurs indicateurs"

#: ui/batteryWidgetSettings.ui:17
msgid "Show icon only (Hide Bar/Dots)"
msgstr "Afficher uniquement l’icône (masquer la barre/les points)"

#: ui/batteryWidgetSettings.ui:18
msgid "Hides the battery level indicator on the icon. Pair with text percentage for battery information"
msgstr "Masque l’indicateur de niveau de batterie sur l’icône. À associer au pourcentage textuel pour obtenir des informations sur la batterie"

#: ui/batteryWidgetSettings.ui:23
msgid "Display battery percentage as text"
msgstr "Afficher le pourcentage de batterie sous forme de texte"

#: ui/batteryWidgetSettings.ui:24
msgid "Displays battery percentage beside the Bluetooth device icon"
msgstr "Affiche le pourcentage de batterie à côté de l’icône de l’appareil BluetoothAffiche le pourcentage de la batterie à côté de l'icône du périphérique Bluetooth"

#: ui/batteryWidgetSettings.ui:29
msgid "Battery Level Indicator Type"
msgstr "Type d'indicateur de niveau de la batterie"

#: ui/batteryWidgetSettings.ui:30
msgid "Dots offer better visibility"
msgstr "Les points offrent une meilleure visibilité"

#: ui/batteryWidgetSettings.ui:42
msgid "Battery Bar Position"
msgstr "Position de la barre de batterie"

#: ui/batteryWidgetSettings.ui:43
msgid "Choose where to display the battery bar relative to the device icon"
msgstr "Choisissez où afficher la barre de batterie par rapport à l’icône de l’appareil"

#: ui/batteryWidgetSettings.ui:55
msgid "Device Icon Size"
msgstr "Taille de l’icône de l’appareil"

#: ui/batteryWidgetSettings.ui:56
msgid "Adjust the size of the device icon displayed above the battery level indicator"
msgstr "Ajustez la taille de l’icône de l’appareil affichée au-dessus de l’indicateur de niveau de batterie"

#: ui/batteryWidgetSettings.ui:71
msgid "Battery Indicator Color Scheme"
msgstr "Schéma de couleur indicateur de batterie"

#: ui/batteryWidgetSettings.ui:72
msgid "Choose color scheme for level bar/dots"
msgstr "Choisir le schéma de couleur pour les barres/points de niveau"

#: ui/batteryWidgetSettings.ui:89
msgid "Circle Widget Settings"
msgstr "Paramètres du widget circulaire"

#: ui/batteryWidgetSettings.ui:92
msgid "Circle Widget Color Scheme"
msgstr "Schéma de couleurs du widget circulaire"

#: ui/batteryWidgetSettings.ui:93
msgid "Choose color scheme for battery circle widget"
msgstr "Choisissez le schéma de couleurs du widget circulaire de batterie"

#: ui/batteryWidgetSettings.ui:111
msgid "Battery Level Bar"
msgstr "Barre de niveau de la batterie"

#: ui/batteryWidgetSettings.ui:112
msgid "Battery Level Dot"
msgstr "Point de niveau de la batterie"

#: ui/batteryWidgetSettings.ui:119
msgid "Below"
msgstr "En dessous"

#: ui/batteryWidgetSettings.ui:124 ui/batteryWidgetSettings.ui:131
msgid "Symbolic"
msgstr "Symbolic"

#: ui/batteryWidgetSettings.ui:125 ui/batteryWidgetSettings.ui:132
msgid "Colored"
msgstr "Coloré"

#: ui/batteryWidgetSettings.ui:126 ui/batteryWidgetSettings.ui:133
msgid "Customized"
msgstr "Personnalisé"

#: ui/devices/nothingBuds.ui:9 ui/devices/sony.ui:9 ui/devices/airpods.ui:9 ui/devices/galaxyBuds.ui:9 ui/quickSettings.ui:9
msgid "Note!"
msgstr "Remarque !"

#: ui/devices/nothingBuds.ui:22 ui/devices/sony.ui:22 ui/devices/airpods.ui:22 ui/devices/galaxyBuds.ui:22
msgid "Some models/features are not fully tested. Please share feedback on GitHub."
msgstr "Certains modèles/fonctionnalités ne sont pas entièrement testés. Veuillez partager vos commentaires sur GitHub."

#: ui/devices/nothingBuds.ui:29
msgid "Nothing/CMF Buds Settings"
msgstr "Paramètres des Nothing/CMF Buds"

#: ui/devices/nothingBuds.ui:32
msgid "Enable Nothing/CMF Buds Support"
msgstr "Activer la prise en charge des Nothing/CMF Buds"

#: ui/devices/nothingBuds.ui:33
msgid "Enables battery status monitoring and, if supported, control of Noise Cancellation."
msgstr "Active la surveillance de l’état de batterie et, si elle est prise en charge, le contrôle de l’annulation du bruit."

#: ui/devices/sony.ui:5
msgid "Sony Bluetooth Audio"
msgstr "Audio Bluetooth Sony"

#: ui/devices/sony.ui:29
msgid "Sony Bluetooth Audio Settings"
msgstr "Paramètres audio Bluetooth Sony"

#: ui/devices/sony.ui:32
msgid "Enable Sony Bluetooth Audio Support"
msgstr "Activer la prise en charge de l’audio Bluetooth Sony"

#: ui/devices/sony.ui:33 ui/devices/airpods.ui:43 ui/devices/galaxyBuds.ui:33
msgid "Enables battery status monitoring and, if supported, control of Noise Cancellation and Conversation Awareness modes."
msgstr "Active la surveillance de l’état de batterie et, si elle est prise en charge, le contrôle des modes d’annulation du bruit et de conscience de conversation."

#: ui/devices/airpods.ui:27
msgid "Conversation Awareness (if supported) works only with the A2DP profile."
msgstr "La conscience de conversation (si prise en charge) ne fonctionne qu’avec le profil A2DP."

#: ui/devices/airpods.ui:32
msgid "ANC and Conversation Awareness buttons are hidden when the earbuds are not in-ear."
msgstr "Les boutons ANC et de conscience de conversation sont masqués lorsque les écouteurs ne sont pas en place."

#: ui/devices/airpods.ui:39
msgid "AirPods/Beats Settings"
msgstr "Paramètres AirPods/Beats"

#: ui/devices/airpods.ui:42
msgid "Enable AirPods/Beats Support"
msgstr "Activer la prise en charge des AirPods/Beats"

#: ui/devices/galaxyBuds.ui:29
msgid "Samsung Galaxy Buds Settings"
msgstr "Paramètres des Samsung Galaxy Buds"

#: ui/devices/galaxyBuds.ui:32
msgid "Enable Samsung Galaxy Buds Support"
msgstr "Activer la prise en charge des Samsung Galaxy Buds"

#: ui/upowerDevices.ui:5
msgid "UPower"
msgstr "Alimentation"

#: ui/upowerDevices.ui:9
msgid "Enable UPower Devices"
msgstr "Activer les appareils UPower"

#: ui/upowerDevices.ui:12
msgid "Enable indicator for UPower devices"
msgstr "Activer l’indicateur pour les appareils UPower"

#: ui/upowerDevices.ui:13
msgid "Certain UPower devices, such as 2.4GHz wireless mouse, keyboard, etc, can report battery levels if supported by the kernel or third-party drivers. Enable this option to display their battery status in the GNOME system tray."
msgstr ""
"Certains appareils UPower, tels que la souris sans fil 2,4 GHz, le clavier, etc., peuvent signaler les niveaux de batterie s’ils sont pris en charge par le noyau ou des pilotes tiers. Activez cette option pour afficher leur état de batterie dans la barre d’état système "
"GNOME.Certains périphériques UPower, tels que la souris sans fil 2.4GHz, le clavier, etc, peuvent signaler les niveaux de batterie si pris en charge par le noyau ou par des pilotes tiers. Activez cette option pour afficher leur état de batterie dans la barre d'état système GNOME."

#: ui/upowerDevices.ui:21 ui/device.ui:10
msgid "Note: General settings override device-specific settings"
msgstr "Remarque : les paramètres généraux remplacent les paramètres spécifiques à l’appareilNote: Les paramètres généraux remplacent les paramètres spécifiques à l'appareil"

#: ui/upowerDevices.ui:24
msgid "No compatible device found!"
msgstr "Aucun appareil compatible détecté!"

#: ui/quickSettings.ui:17
msgid "Quick Menu Settings"
msgstr "Paramètres du menu rapide"

#: ui/quickSettings.ui:20
msgid "Modify Bluetooth device menu"
msgstr "Modifier le menu des appareils Bluetooth"

#: ui/quickSettings.ui:21
msgid "Add battery information and device controls to the menu"
msgstr "Ajouter des informations de batterie et des commandes d’appareil au menu"

#: ui/quickSettings.ui:26
msgid "Enable popup submenu widget mode"
msgstr "Activer le mode de sous-menu contextuel"

#: ui/quickSettings.ui:27
msgid "Adds a submenu that displays battery levels and other controls (ANC) if available"
msgstr "Ajoute un sous-menu affichant les niveaux de batterie et d’autres commandes (ANC) si disponibles"

#: ui/quickSettings.ui:32
msgid "Show battery icon for Bluetooth devices"
msgstr "Activer les indicateurs de batterie pour les appareils Bluetooth"

#: ui/quickSettings.ui:33
msgid "Displays an icon in the popup menu for Bluetooth device battery level"
msgstr "Affiche une icône dans le menu contextuel pour le niveau de batterie de l’appareil BluetoothAffiche une icône dans le menu contextuel pour le niveau de batterie de l'appareil Bluetooth"

#: ui/quickSettings.ui:38
msgid "Show Bluetooth device battery percentage"
msgstr "Afficher le pourcentage de batterie du périphérique Bluetooth"

#: ui/quickSettings.ui:39
msgid "Displays Bluetooth device battery level percentage in text"
msgstr "Affiche le niveau de charge du périphérique Bluetooth en pourcentage"

#: ui/quickSettings.ui:44
msgid "Display battery level icon before text"
msgstr "Afficher l'icône du niveau de batterie avant le texte"

#: ui/quickSettings.ui:45
msgid "Swaps position of battery level icon and percentage text"
msgstr "Interverti la position de l’icône du niveau de batterie et du texte en pourcentageInterverti la position de l'icône du niveau de batterie et du texte en pourcentage"

#: ui/quickSettings.ui:52
msgid "Sort By History"
msgstr "Trier par historique"

#: ui/quickSettings.ui:55
msgid "Sort devices by connection history"
msgstr "Trier les périphériques par historique de connexion"

#: ui/quickSettings.ui:56
msgid "Enable to sort devices by connection history, or disable to sort by connection status and alias"
msgstr "Activez pour trier les appareils par historique de connexion, ou désactivez pour trier par statut de connexion et aliasActiver pour trier les appareils par historique de connexion, ou désactiver pour trier par statut de connexion et alias"

