#: ui/budslinkCompanion.ui:17
msgid ""
"Acts as a Companion with the BudsLink app, which runs in the background to "
"provide additional features for supported headphones and earbuds"
msgstr ""
"Funciona como complemento de la aplicación BudsLink, que se ejecuta en "
"segundo plano para ofrecer funciones adicionales en los auriculares de "
"diadema e intraurales compatibles"

#: ui/budslinkCompanion.ui:22
msgid "Hide from Background Apps"
msgstr "Ocultar de las aplicaciones en segundo plano"

#: ui/budslinkCompanion.ui:23
msgid "Hide BudsLink from the GNOME Background Apps list"
msgstr "Ocultar BudsLink de la lista de aplicaciones en segundo plano de GNOME"

