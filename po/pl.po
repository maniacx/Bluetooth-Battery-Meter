#: ui/batteryWidgetSettings.ui:5
msgid "Battery Widget Settings"
msgstr "Ustawienia widżetu baterii"

#: ui/batteryWidgetSettings.ui:9
msgid "Indicator Widget Settings"
msgstr "Ustawienia widżetu wskaźnika"

#: ui/batteryWidgetSettings.ui:12
msgid ""
"Indicator Battery Widget Settings available only for System Tray mode or "
"Panel Button mode with multiple indicators"
msgstr ""
"Ustawienia widżetu wskaźnika baterii są dostępne tylko dla trybu 'Zasobnika "
"systemowego' lub 'Przycisku panelu' z wieloma wskaźnikami"

#: ui/batteryWidgetSettings.ui:17
msgid "Show icon only (Hide Bar/Dots)"
msgstr "Pokaż tylko ikonę (ukryj pasek/kropki)"

#: ui/batteryWidgetSettings.ui:18
msgid ""
"Hides the battery level indicator on the icon. Pair with text percentage for "
"battery information"
msgstr ""
"Ukrywa wskaźnik poziomu naładowania baterii na ikonie. Połącz z tekstem, aby "
"wyświetlić informację o stanie baterii w procentach"

#: ui/batteryWidgetSettings.ui:29
msgid "Display battery percentage as text"
msgstr "Wyświetlaj procent baterii jako tekst"

#: ui/batteryWidgetSettings.ui:30
msgid "Displays battery percentage beside the Bluetooth device icon"
msgstr "Wyświetla procent baterii obok ikony urządzenia Bluetooth"

#: ui/batteryWidgetSettings.ui:41
msgid "Battery Level Indicator Type"
msgstr "Typ wskaźnika poziomu baterii"

#: ui/batteryWidgetSettings.ui:42
msgid "Dots offer better visibility"
msgstr "Kropki zapewniają lepszą widoczność"

#: ui/batteryWidgetSettings.ui:54
msgid "Battery Bar Position"
msgstr "Pozycja paska baterii"

#: ui/batteryWidgetSettings.ui:55
msgid "Choose where to display the battery bar relative to the device icon"
msgstr ""
"Wybierz, gdzie ma być wyświetlany pasek baterii względem ikony urządzenia"

#: ui/batteryWidgetSettings.ui:67
msgid "Device Icon Size"
msgstr "Rozmiar ikony urządzenia"

#: ui/batteryWidgetSettings.ui:68
msgid ""
"Adjust the size of the device icon displayed above the battery level "
"indicator"
msgstr ""
"Dostosuj rozmiar ikony urządzenia wyświetlanej nad wskaźnikiem poziomu "
"baterii"

#: ui/batteryWidgetSettings.ui:83
msgid "Battery Indicator Color Scheme"
msgstr "Schemat kolorów wskaźnika baterii"

#: ui/batteryWidgetSettings.ui:84
msgid "Choose color scheme for level bar/dots"
msgstr "Wybierz schemat kolorów dla paska/kropek poziomu"

#: ui/batteryWidgetSettings.ui:101
msgid "Circle Widget Settings"
msgstr "Ustawienia widżetu koła"

#: ui/batteryWidgetSettings.ui:104
msgid "Circle Widget Color Scheme"
msgstr "Schemat kolorów widżetu koła"

#: ui/batteryWidgetSettings.ui:105
msgid "Choose color scheme for battery circle widget"
msgstr "Wybierz schemat kolorów dla widżetu koła baterii"

#: ui/batteryWidgetSettings.ui:123
msgid "Battery Level Bar"
msgstr "Pasek poziomu baterii"

#: ui/batteryWidgetSettings.ui:124
msgid "Battery Level Dot"
msgstr "Kropka poziomu baterii"

#: ui/batteryWidgetSettings.ui:129
msgid "Left"
msgstr "Po lewej"

#: ui/batteryWidgetSettings.ui:130
msgid "Right"
msgstr "Po prawej"

#: ui/batteryWidgetSettings.ui:131
msgid "Below"
msgstr "Poniżej"

#: ui/batteryWidgetSettings.ui:136 ui/batteryWidgetSettings.ui:143
msgid "Symbolic"
msgstr "Symboliczna"

#: ui/batteryWidgetSettings.ui:137 ui/batteryWidgetSettings.ui:144
msgid "Colored"
msgstr "Kolorowa"

#: ui/batteryWidgetSettings.ui:138 ui/batteryWidgetSettings.ui:145
msgid "Customized"
msgstr "Spersonalizowana"

#: ui/device.ui:5
msgid "Device"
msgstr "Urządzenie"

#: ui/device.ui:9 ui/gattBas.ui:35 ui/upowerDevices.ui:26
msgid "Configuration by Device"
msgstr "Konfiguracja według urządzenia"

#: ui/device.ui:10 ui/upowerDevices.ui:27
msgid "Note: General settings override device-specific settings"
msgstr ""
"Uwaga: Ustawienia ogólne zastępują ustawienia specyficzne dla urządzenia"

#: ui/device.ui:13
msgid "No Bluetooth device paired!"
msgstr "Brak sparowanego urządzenia!"

#: ui/gattBas.ui:15
msgid "Experimental"
msgstr "Funkcja eksperymentalna"

#: ui/gattBas.ui:18
msgid "Battery Service (BAS) Settings"
msgstr "Ustawienia Usługi baterii (BAS)"

#: ui/gattBas.ui:21
msgid "Enable GATT Battery Service Reporting"
msgstr "Włącz raportowanie usługi baterii GATT"

#: ui/gattBas.ui:22
msgid ""
"Display battery levels for Bluetooth devices using the GATT Battery Service "
"(BAS)."
msgstr ""
"Wyświetlaj poziom naładowania baterii urządzeń Bluetooth, używając usługi "
"baterii GATT (BAS)"

#: ui/gattBas.ui:38
msgid "No compatible device paired!"
msgstr "Brak sparowanego, kompatybilnego urządzenia!"

#: ui/indicator.ui:9
msgid "Bluetooth System Indicator Settings"
msgstr "Ustawienia wskaźnika systemu Bluetooth"

#: ui/indicator.ui:12
msgid "Bluetooth Connection Status Indicator"
msgstr "Wskaźnik stanu połączenia Bluetooth"

#: ui/indicator.ui:13
msgid ""
"Hide conditionally: Displayed only when no other bluetooth related "
"indicators are present"
msgstr ""
"Ukryj warunkowo: Wyświetlaj tylko, gdy nie ma innych wskaźników związanych z "
"Bluetooth"

#: ui/indicator.ui:27
msgid "Battery Indicator Settings"
msgstr "Ustawienia wskaźnika baterii"

#: ui/indicator.ui:30
msgid "Choose Indicator mode"
msgstr "Wybierz tryb wskaźnika"

#: ui/indicator.ui:31
msgid ""
"Off: No battery indicator.\n"
"System Indicator: Battery icon in top bar.\n"
"Panel Button: Battery icon with menu."
msgstr ""
"Wyłączone: Brak wskaźnika baterii.\n"
"Wskaźnik systemowy: Ikona baterii na górnym pasku.\n"
"Przycisk panelu: Ikona baterii z menu."

#: ui/indicator.ui:45
msgid "Panel Button Mode"
msgstr "Tryb przycisku panela"

#: ui/indicator.ui:48
msgid "Panel button indicator mode."
msgstr "Tryb wskaźnika przycisku panelu."

#: ui/indicator.ui:49
msgid "On: Show one selected device. Off: Show all devices"
msgstr ""
"Włączone: Pokaż jedno wybrane urządzenie. Wyłączone: Pokaż wszystkie "
"urządzenia"

#: ui/indicator.ui:62
msgid "Indicator Settings"
msgstr "Ustawienia wskaźnika"

#: ui/indicator.ui:65
msgid "Show Separate Battery Indicators"
msgstr "Pokaż oddzielne wskaźniki baterii"

#: ui/indicator.ui:66
msgid ""
"When enabled, display one indicator per battery. When disabled, show a "
"single indicator with the most critical (lowest) battery level."
msgstr ""
"Gdy włączono, wyświetlaj jeden wskaźnik dla każdej baterii. Gdy wyłączono, "
"wyświetlaj jeden wskaźnik z najbardziej krytycznym (najniższym) poziomem "
"naładowania baterii."

#: ui/indicator.ui:79
msgid "Show Popup on Hover"
msgstr "Pokaż wyskakujące okienko po najechaniu"

#: ui/indicator.ui:82
msgid "Show Detailed Info on Hover"
msgstr "Pokaż szczegółowe informacje po najechaniu"

#: ui/indicator.ui:83
msgid ""
"Displays a popup with battery info and controls when the mouse pointer "
"hovers over the indicator for a custom delay"
msgstr ""
"Wyświetla wyskakujące okienko z informacjami o baterii i opcjami sterowania, "
"gdy kursor myszy najedzie na wskaźnik po niestandardowym opóźnieniu"

#: ui/indicator.ui:94
msgid "Hover Activation Delay"
msgstr "Opóźnienie aktywacji po najechaniu"

#: ui/indicator.ui:95
msgid ""
"Specify the number of seconds the mouse must hover over the indicator before "
"detailed information is displayed."
msgstr ""
"Określ, ile sekund kursor myszy musi znajdować się nad wskaźnikiem, zanim "
"zostaną wyświetlone szczegółowe informacje."

#: ui/indicator.ui:114
msgid "Default Behaviour"
msgstr "Domyślne zachowanie"

#: ui/indicator.ui:115
msgid "Hide Always"
msgstr "Zawsze ukrywaj"

#: ui/indicator.ui:116
msgid "Hide Conditionally"
msgstr "Ukryj warunkowo"

#: ui/indicator.ui:121
msgid "Off"
msgstr "Wył"

#: ui/indicator.ui:122
msgid "System Tray"
msgstr "Zasobnik systemowy"

#: ui/indicator.ui:123
msgid "Panel Button"
msgstr "Przycisk panelu"

#: ui/quickSettings.ui:9
msgid "Note!"
msgstr "Uwaga!"

#: ui/quickSettings.ui:17
msgid "Quick Menu Settings"
msgstr "Ustawienia szybkiego menu"

#: ui/quickSettings.ui:20
msgid "Enable popup submenu widget mode"
msgstr "Włącz tryb widżetu wyskakującego podmenu"

#: ui/quickSettings.ui:21
msgid ""
"Adds a submenu that displays battery levels and other controls (ANC) if "
"available"
msgstr ""
"Dodaje podmenu, które wyświetla poziomy naładowania baterii oraz inne opcje "
"sterowania (ANC), jeśli są dostępne"

#: ui/quickSettings.ui:32
msgid "Show battery icon for Bluetooth devices"
msgstr "Pokaż ikonę baterii dla urządzeń Bluetooth"

#: ui/quickSettings.ui:33
msgid "Displays an icon in the popup menu for Bluetooth device battery level"
msgstr ""
"Wyświetla ikonę w menu wyskakującym dla poziomu naładowania baterii "
"urządzenia Bluetooth"

#: ui/quickSettings.ui:44
msgid "Show Bluetooth device battery percentage"
msgstr "Pokaż procent baterii urządzenia Bluetooth"

#: ui/quickSettings.ui:45
msgid "Displays Bluetooth device battery level percentage in text"
msgstr ""
"Wyświetla procentowy poziom naładowania baterii urządzenia Bluetooth w "
"formie tekstu"

#: ui/quickSettings.ui:56
msgid "Display battery level icon before text"
msgstr "Pokaż ikonę poziomu baterii przed tekstem"

#: ui/quickSettings.ui:57
msgid "Swaps position of battery level icon and percentage text"
msgstr "Zamienia miejscami ikonę poziomu baterii z tekstem procentowym"

#: ui/quickSettings.ui:70
msgid "Sort By History"
msgstr "Sortuj według historii"

#: ui/quickSettings.ui:73
msgid "Sort devices by connection history"
msgstr "Sortuj urządzenia według historii połączeń"

#: ui/quickSettings.ui:74
msgid ""
"Enable to sort devices by connection history, or disable to sort by "
"connection status and alias"
msgstr ""
"Włącz, aby sortować urządzenia według historii połączeń, lub wyłącz, aby "
"sortować według stanu połączenia i pseudonimu"

#: ui/upowerDevices.ui:5
msgid "UPower"
msgstr "UPower"

#: ui/upowerDevices.ui:9
msgid "Enable UPower Devices"
msgstr "Włącz urządzenia UPower"

#: ui/upowerDevices.ui:12
msgid "Enable indicator for UPower devices"
msgstr "Włącz wskaźnik dla urządzeń UPower"

#: ui/upowerDevices.ui:13
msgid ""
"Certain UPower devices, such as 2.4GHz wireless mouse, keyboard, etc, can "
"report battery levels if supported by the kernel or third-party drivers. "
"Enable this option to display their battery status in the GNOME system tray."
msgstr ""
"Niektóre urządzenia UPower, takie jak mysz bezprzewodowa 2,4 GHz, klawiatura "
"itp., mogą raportować poziom naładowania baterii, jeśli są obsługiwane przez "
"jądro lub sterowniki innych firm. Włącz tę opcję, aby wyświetlać stan ich "
"baterii w zasobniku systemowym GNOME."

#: ui/upowerDevices.ui:30
msgid "No compatible device found!"
msgstr "Nie znaleziono kompatybilnego urządzenia!"

