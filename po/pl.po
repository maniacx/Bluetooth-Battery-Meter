msgid "Pause when device is not worn"
msgstr "Wstrzymaj, gdy urządzenie nie jest noszone"

#: preferences/airpodsConfigureWindow.js:51
msgid "Pause playback when the device is removed,resume when it is put back on"
msgstr ""
"Wstrzymaj odtwarzanie, gdy urządzenie zostanie zdjęte, wznow, gdy zostanie "
"ponownie założone"

