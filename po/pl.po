#: ui/batteryWidgetSettings.ui:108 ui/batteryWidgetSettings.ui:115
msgid "Colored"
msgstr "Kolorowa"

#: ui/batteryWidgetSettings.ui:109 ui/batteryWidgetSettings.ui:116
