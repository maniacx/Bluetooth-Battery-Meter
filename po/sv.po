msgid "Installation Status"
msgstr "Installationsstatus"

#: ui/budslinkCompanion.ui:40
msgid "BudsLink Installation Status"
msgstr "Installationsstatus för BudsLink"

#: ui/budslinkCompanion.ui:49
msgid "BudsLink on Flathub"
msgstr "BudsLink på Flathub"

#: ui/budslinkCompanion.ui:61
