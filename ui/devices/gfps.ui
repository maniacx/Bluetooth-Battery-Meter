<?xml version="1.0" encoding="UTF-8"?>
<interface domain="Bluetooth-Battery-Meter@maniacx.github.com">
  <template class="BluetoothBatteryMeter_PixelBudsUI" parent="AdwPreferencesPage">
    <property name="name">PixelBuds</property>
    <property name="title" translatable="yes">Google Pixel Buds</property>
    <property name="icon-name">bbm-earbuds-stem3-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Note!</property>
        <property name="header-suffix">
          <object class="GtkButton">
            <property name="halign">start</property>
            <property name="valign">center</property>
            <property name="margin-start">6</property>
            <property name="css-classes">error</property>
            <property name="can-focus">False</property>
            <property name="label" translatable="yes">Experimental</property>
          </object>
        </property>
        <child>
          <object class="AdwActionRow">
            <property name="subtitle" translatable="yes">Google Pixel Buds Pro features are experimental. Please share feedback on GitHub.</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Google Pixel Buds Settings</property>
        <child>
          <object class="AdwSwitchRow" id="enable_pixel_buds_device">
            <property name="title" translatable="yes">Enable Google Pixel Buds Support</property>
            <property name="subtitle" translatable="yes">Enables battery status monitoring and control of Active Noise Cancellation (ANC).</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="pixel_buds_group">
        <property name="title" translatable="yes">Configuration by Device</property>
        <child>
          <object class="AdwActionRow" id="no_pixel_buds_paired_row">
            <property name="title" translatable="yes">No compatible device paired!</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
